#!/usr/bin/env bash
# Conventional commits, by commitlint. The rules -- the types, the 72-character subject -- are in
# commitlint.config.mjs, so the hook and the CI check cannot drift apart.
# Enable once per clone:  git config core.hooksPath scripts/githooks   (the `prepare` script does it)
#
# Merges, reverts and fixups are written by git, not by hand; commitlint ignores them itself
# (`defaultIgnores`), so there is nothing to special-case here.
#
# `git commit --no-verify` skips this. CI lints the whole range of a pull request, so a skipped
# message is found there instead.
set -euo pipefail
exec bunx --bun commitlint --edit "$1"
