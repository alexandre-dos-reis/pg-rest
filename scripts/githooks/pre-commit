#!/usr/bin/env bash
# Enable once per clone:  git config core.hooksPath scripts/githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Not piped into grep -q: that exits on the first match, git gets SIGPIPE, and pipefail
# would make the whole condition false -- silently skipping the check.
staged="$(git diff --cached --name-only)"

# Only worth running when a version or an example dependency is actually being committed.
if grep -qE '^(package\.json|packages/[^/]+/package\.json|examples/[^/]+/package\.json)$' <<<"$staged"; then
  bun run scripts/check-example-versions.ts
fi

# A changeset is read by `changeset version` months later, and a bad one is only found then -- a
# summary with no type leaves the released notes ungrouped, and a package that is not in the
# workspace stops the release outright. Both are free to catch here.
if grep -qE '^\.changeset/.+\.md$' <<<"$staged"; then
  bun run scripts/check-changesets.ts
fi
