{
  "name": "pg-rest",
  "type": "module",
  "version": "0.0.0",
  "description": "A PostgREST-compatible REST layer for PostgreSQL, built for Bun and consumed as a library. You decide who the user is (RLS) — no JWT required.",
  "author": "Alexandre Dos Reis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandre-dos-reis/pg-rest.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "effect": "^4.1.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsdown": "^0.17.0",
    "typescript": "^5.9.3"
  }
}
