{
  "name": "pg-rest",
  "type": "module",
  "version": "0.0.0",
  "description": "A PostgREST-compatible REST layer for PostgreSQL, consumed as a library (Bun, Node.js and other runtimes with web-standard Request/Response). You decide who the user is (RLS) — no JWT required.",
  "author": "Alexandre Dos Reis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandre-dos-reis/pg-rest.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "test:compare": "bun test tests/compare"
  },
  "dependencies": {
    "effect": "^4.1.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsdown": "^0.17.0",
    "typescript": "^5.9.3"
  }
}
