{
  "name": "tspg",
  "private": true,
  "description": "Monorepo of @tspg/rest (a PostgREST-compatible handler) and @tspg/query (typed in-process queries).",
  "license": "MIT",
  "author": "Alexandre Dos Reis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandre-dos-reis/tspg.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun --filter '@tspg/rest' --filter '@tspg/query' build",
    "dev": "bun --filter '@tspg/rest' --filter '@tspg/query' dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:compare": "bun test ./packages/rest/tests/compare/",
    "bench": "bun bench/run.ts",
    "changeset": "changeset",
    "version": "changeset version && bun run scripts/changelog-sections.ts && bun run check:examples --fix && bun install --lockfile-only",
    "release": "changeset publish",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath scripts/githooks || true",
    "check:examples": "bun run scripts/check-example-versions.ts",
    "check:changesets": "bun run scripts/check-changesets.ts",
    "gen:parsed": "bun run scripts/gen-parsed-fixtures.ts",
    "link:examples": "scripts/link-examples.sh",
    "lint": "oxlint packages tests",
    "fmt": "oxfmt packages tests",
    "fmt:check": "oxfmt --check packages tests"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@electric-sql/pglite": "^0.5.15",
    "@hono/node-server": "^2.1.6",
    "@neondatabase/postgrest-js": "^0.2.0-beta",
    "@supabase/postgrest-js": "^2.119.0",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "autocannon": "^8.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "pg": "^8.23.1",
    "postgres": "^4.0.0",
    "tsdown": "^0.23.7",
    "typescript": "7.1.0-beta"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "warn"
    }
  }
}
