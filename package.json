{
  "name": "@adrdp/pg-rest",
  "version": "0.1.3",
  "description": "A PostgREST-compatible REST layer for PostgreSQL, consumed as a library (Bun, Node.js and other runtimes with web-standard Request/Response). You decide who the user is (RLS) — no JWT required.",
  "license": "MIT",
  "author": "Alexandre Dos Reis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandre-dos-reis/pg-rest.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/bun": {
      "types": "./dist/adapters/bun.d.ts",
      "default": "./dist/adapters/bun.js"
    },
    "./adapters/node-postgres": {
      "types": "./dist/adapters/node-postgres.d.ts",
      "default": "./dist/adapters/node-postgres.js"
    },
    "./adapters/postgres-js": {
      "types": "./dist/adapters/postgres-js.d.ts",
      "default": "./dist/adapters/postgres-js.js"
    },
    "./adapters/pglite": {
      "types": "./dist/adapters/pglite.d.ts",
      "default": "./dist/adapters/pglite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "test:compare": "bun test tests/compare",
    "bench": "bun bench/run.ts",
    "changeset": "changeset",
    "version": "changeset version && bun run check:examples --fix && bun install --lockfile-only",
    "release": "changeset publish",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath scripts/githooks || true",
    "check:examples": "bun run scripts/check-example-versions.ts",
    "link:examples": "scripts/link-examples.sh",
    "lint": "oxlint src tests",
    "fmt": "oxfmt src tests",
    "fmt:check": "oxfmt --check src tests"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@electric-sql/pglite": "^0.5.15",
    "@hono/node-server": "^2.1.6",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "autocannon": "^8.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "pg": "^8.23.1",
    "postgres": "^4.0.0",
    "tsdown": "^0.17.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.2.0",
    "pg": "^8.0.0",
    "postgres": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    }
  }
}
