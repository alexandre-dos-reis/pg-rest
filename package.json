    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.10.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.16.0",
    "bumpp": "^10.3.2",
    "tsdown": "^0.17.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@effect/language-service": "^0.62.5",
    "@effect/platform-node": "^0.104.0",
    "effect": "^3.19.13",
    "pg": "^8.16.3"
  }
