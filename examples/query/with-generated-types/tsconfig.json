{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "types": [
      "bun"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
