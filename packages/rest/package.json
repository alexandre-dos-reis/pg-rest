{
  "name": "@tsql/rest",
  "version": "0.0.0",
  "description": "A PostgREST-compatible REST layer for PostgreSQL, consumed as a library (Bun, Node.js and other runtimes with web-standard Request/Response). You decide who the user is (RLS) -- no JWT required.",
  "license": "MIT",
  "author": "Alexandre Dos Reis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandre-dos-reis/pg-rest.git",
    "directory": "packages/rest"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./adapters": "./dist/adapters/index.js",
    "./adapters/bun": "./dist/adapters/bun.js",
    "./adapters/node-postgres": "./dist/adapters/node-postgres.js",
    "./adapters/pglite": "./dist/adapters/pglite.js",
    "./adapters/postgres-js": "./dist/adapters/postgres-js.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@tsql/adapters": "workspace:*",
    "@tsql/core": "workspace:*"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.2.0",
    "pg": "^8.0.0",
    "postgres": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    }
  }
}
